/* window that shows up when you add effects */

lmms--gui--EffectSelectDialog QScrollArea {
	background: #404040;
}

lmms--gui--SetupDialog QScrollArea {
	border: 0px;
}

/* the inner boxes in LADSPA effect windows */

lmms--gui--EffectControlDialog QGroupBox {
	background: #303030;
	margin-top: 1ex;
	padding: 10px 2px 2px;
	border-radius: 0px;
	border: none;
}

/* the inner box titles when present (channel 1, channel 2...) */

lmms--gui--EffectControlDialog QGroupBox::title {
	subcontrol-origin: margin;
	subcontrol-position: top center;
	background: #303030;
	color: #bbb;
	border-radius: 0px;
	border: none;
	padding: 2px 2px;
}

/* main toolbar */

QWidget#mainToolbar {
	background: qlineargradient(spread:reflect, x1:0, y1:0, x2:0, y2:1, stop:0 #303030, stop:1 #343434);
}

/* smaller toolbars */

QToolBar {
	background: qlineargradient(spread:reflect, x1:0, y1:0, x2:0, y2:1, stop:0 #303030, stop:1 #303030);
	border: none;
	padding: 0 0 0 0px;
	spacing: 0;
}

QToolBar::separator {
	border: none;
	width: 0px;
}

/* all tool buttons */

QToolButton, QToolButton::menu-button {
	margin: 1px;
	padding: 2px 2px 2px 2px;
	/*border-top: 1px solid #303030;
	border-bottom: 2px solid #303030;*/
	border-radius: 0px;
	background: qlineargradient(spread:reflect, x1:0, y1:0, x2:0, y2:1 stop:0 #61797c, stop:1 #61696c);
	font-size:10px;
	color: #bbb;
}

QToolButton:hover {
	border-radius: 0px;
	background: qlineargradient(spread:reflect, x1:0, y1:0, x2:0, y2:1, stop:0 #51696c, stop:1 #51595c)
}

QToolButton:hover:checked {
	border: 0px solid #343840;
	border-radius: 0px;
	background: qlineargradient(spread:reflect, x1:0, y1:0, x2:0, y2:1, stop:0 #292d33, stop:1 #22262c)
}

QToolButton:pressed {
	border-top: 1px solid #778394;
	border-bottom: 1px solid #252525;
	border-radius: 0px;
	background: qlineargradient(spread:reflect, x1:0, y1:0, x2:0, y2:1, stop:0 #636c7a, stop:1 #262b30);
}

QToolButton:checked {
	border-top: 1px solid #252525;
	border-bottom: 1px solid #4f5e5c;
	background: qlineargradient(spread:reflect, x1:0, y1:0, x2:0, y2:1, stop:0 #2b2f32, stop:1 #23262a);
}

/* buttons with combined menu */

QToolButton[popupMode="1"] {
	margin-right: 15px;
	border-top-right-radius: 5;
	border-bottom-right-radius: 5;
}

QToolButton::menu-button {
	subcontrol-origin: margin;
	width: 13px;
	padding: 0;
	border-top-left-radius: 0;
	border-bottom-left-radius: 0;
}

/* track label buttons - the part that contains the icon and track title */

lmms--gui--TrackLabelButton {
	background-color: #404040;
	font-size: 12px;
	font-weight: bold;
	padding: 2px 2px;
}

lmms--gui--TrackLabelButton:hover {
	background: #505050;
	border-radius: none;
}

lmms--gui--TrackLabelButton:pressed {
	background: #333;
	border-radius: none;
}

lmms--gui--TrackLabelButton:checked {
	border: 2px solid #61797c;
	background: #404040;
	border-radius: none;
}

lmms--gui--TrackLabelButton:checked:pressed {
	border: 2px solid #bbb;
	background: #353535;
	font-weight: solid;
}

/* sidebar, sidebar buttons */

lmms--gui--SideBar {
	subcontrol-position: center;
	background: qlineargradient(spread:reflect, x1:0, y1:0, x2:0, y2:1, stop:0 #303030,  stop:1 #303030);
}

lmms--gui--SideBar QToolButton {
	background: none;
	border: none;
	font-size: 12px;
}

lmms--gui--SideBar QToolButton:hover {
	background: none;
	border: none;
	font-size: 12px;
}

lmms--gui--SideBar QToolButton:pressed {
	background: none;
	border: none;
	font-size: 12px;
}

lmms--gui--SideBar QToolButton:checked {
	background: qlineargradient(spread:reflect, x1:0, y1:0, x2:0, y2:1, stop:0 #404040, stop:1 #404040);
	border: none;
	font-size: 12px;
}

/* Instrument plugin list */

lmms--gui--PluginDescWidget {
	border: 3px solid #202020;
  padding-bottom: 5px;
	border-radius: 0px;
	background-color: qlineargradient(spread:reflect, x1:0, y1:0, x2:0, y2:1, stop:0 #40, stop:1 #40);
	color: #bbb;
  font-size: 12px;
	font-weight: bold;
	margin: 0px;
}

lmms--gui--PluginDescWidget:hover {
	background: qlineargradient(spread:reflect, x1:0, y1:0, x2:0, y2:1, stop:0 #61797c, stop:1 #61797c);
	color: #999;
}

/* piano widget */

lmms--gui--PianoView {
	background-color: #303030;
}

/* font sizes for text buttons */

lmms--gui--MixerView QPushButton,
lmms--gui--EffectRackView QPushButton,
lmms--gui--ControllerRackView QPushButton {
	font-size: 11px;
}

lmms--gui--MixerChannelView {
	background: #404040;
	color: #bbb;
	qproperty-backgroundActive: #303030;
	qproperty-strokeOuterActive: #292929;
	qproperty-strokeOuterInactive: #505050;
	qproperty-strokeInnerActive: #252525;
	qproperty-strokeInnerInactive: #505050;
}

lmms--gui--MixerChannelView QGraphicsView {
	background: transparent;
	border-style: none;
}

lmms--gui--PeakIndicator {
	background-color: #555555;
	font-size: 9pt;
}

/* persistent peak markers for fx peak meters */
lmms--gui--Fader {
	qproperty-peakOk: #61797c;
	qproperty-peakWarn: #d6ec52;
	qproperty-peakClip: #c12038;
}

lmms--gui--TimeLineWidget {
	/* font-size only supports px and pt. */
	font-size: 9pt;
	/* lengths also support em. This will make sure that the height
	   will always change in the same proportion as the font size
	   defined above.
	   If you want a fixed size set min and max to the same value. */
	min-height: 1.5em;
	max-height: 1.5em;

	/* Properties for the loop indicator rectangle in inactive state:
	    - LoopColor: Color of the outermost border
	    - LoopBrush: Brush to paint the main portion of the rectangle
	    - LoopInnerColor: Color used to paint the inlayed border
	    - LoopHandleColor: Color used to paint loop marker handles */
	qproperty-inactiveLoopColor: #3B424A;
	qproperty-inactiveLoopBrush: #3B424A;
	qproperty-inactiveLoopInnerColor: #3B424A;
	qproperty-inactiveLoopHandleColor: rgba( 192, 192, 192, 100 );

	/* Properties for the loop indicator rectangle in active state.
	   See above for detailed description. */
	qproperty-activeLoopColor: #61797c;
	qproperty-activeLoopBrush: #61797c;
	qproperty-activeLoopInnerColor: #61797c;
	qproperty-activeLoopHandleColor: rgba( 192, 192, 192, 200 );

	/* Vertical padding for the loop indicator rectangle.
	   A value of zero draws the rectangle at the full height of the widget. */
	qproperty-loopRectangleVerticalPadding: 1;
	/* Width of loop marker handles (when handle mode is active) */
	qproperty-loopHandleWidth: 8;

	qproperty-barLineColor: rgb( 192, 192, 192 );
	qproperty-barNumberColor: rgb( 192, 192, 192 );
}

lmms--gui--TrackContainerView QLabel
{
	background: none;
}

/* Clips */

/* common clip colors */
lmms--gui--ClipView   {
	qproperty-mutedColor: rgba(255,255,255,100);
	qproperty-mutedBackgroundColor: #373d48;
	qproperty-selectedColor: #61797c;
	qproperty-patternClipBackground: #373d48;
	qproperty-textColor: #bbb;
	qproperty-textBackgroundColor: rgba(0, 0, 0, 100);
	qproperty-textShadowColor: rgba(0,0,0,200);
	qproperty-gradient: false; /* boolean property, set true to have a gradient */
	qproperty-markerColor: rgb(0, 0, 0);
	font-size: 11px;
}

/* MIDI (instrument) clip */
lmms--gui--MidiClipView {
	background-color: #61797c;
	color: rgba(255,255,255,220);

	qproperty-noteFillColor: rgba(255, 255, 255, 220);
	qproperty-noteBorderColor: rgb(109, 156, 126);
	qproperty-mutedNoteFillColor: rgba(100, 100, 100, 220);
	qproperty-mutedNoteBorderColor: rgb(55, 61, 72);
}

/* sample track clip */
lmms--gui--SampleClipView {
	background-color: rgba(42,51,59,255);
	color: #FF8F05;
}

/* automation clip */
lmms--gui--AutomationClipView {
	background-color: #c5a26e;
	color: rgba(255,255,255,90);
}

/* pattern clip */
lmms--gui--PatternClipView {
	background-color: #65b6b0; /* default colour for pattern tracks */
	qproperty-emptyTrackHeightRatio: 0.5; /* height of empty tracks versus non-empty tracks */
	qproperty-verticalPadding: 0.15; /* padding above and below the beat preview on the clip, fraction of the total clip height */
	qproperty-noteVerticalSpacing: 0.2; /* spacing above and below each note, fraction of the note height */
	qproperty-noteHorizontalSpacing: 0.2; /* spacing left/right of each note, fraction of the note width */
	qproperty-noteColor: #e0e0cc; /* colour of the beat/note rectangles on the clip */
}
